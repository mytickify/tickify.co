// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  roles    UserRole[]
  events   Event[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Role-based access control
model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users UserRole[]
}

// Join table for many-to-many User ↔ Role
model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// Event-related enums
enum EventStatus {
  DRAFT
  PUBLISHED
  ENDED
}

// Mail subscription enums
enum SubscriptionStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

enum SubscriptionSource {
  FORM
  IMPORT
  ADMIN
  API
}

// Site Builder section types
enum SectionType {
  HERO
  PRICING
  GALLERY
  ABOUT
  SCHEDULE
  CONTACT
}

// Event model aligned to GraphQL type, using JSON for nested structures
model Event {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String
  description     String
  startDate       String
  startTime       String
  endDate         String
  endTime         String
  is_featured     Boolean     @default(false)
  cover_image     String?
  primary_color   String?
  secondary_color String?
  status          EventStatus
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  categories          Category[]

  locationId String? @unique
  location   Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)

  organizerId String? @unique
  organizer   Organizer?  @relation(fields: [organizerId], references: [id], onDelete: SetNull)

  themeId String? @unique
  theme   EventTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)

  imagesId String? @unique
  images   EventImage?  @relation(fields: [imagesId], references: [id], onDelete: SetNull)

  featuresId String? @unique
  features   EventFeatures? @relation(fields: [featuresId], references: [id], onDelete: SetNull)

  ticketTiers  TicketTier[]
  collaborators Collaborator[]

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Category {
  id          String             @id @default(cuid())
  description String             @default("")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  events      Event[]
}

model Location {
  id        String   @id @default(cuid())
  venue     String
  address   String
  city      String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event?
}

model Organizer {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event?
}

model EventTheme {
  id               String   @id @default(cuid())
  primaryColor     String
  secondaryColor   String
  accentColor      String
  textColor        String
  fontFamily       String
  layout           String
  gradientEnabled  Boolean
  gradientDirection String
  backgroundColor  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  event            Event?
}

model EventImage {
  id        String   @id @default(cuid())
  banner    String?
  gallery   String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event?
}

model EventFeatures {
  id                String   @id @default(cuid())
  showGallery       Boolean
  allowGuestUploads Boolean
  showChat          Boolean
  showCollaborators Boolean
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  event             Event?
}

model TicketTier {
  id          String  @id @default(cuid())
  name        String
  price       Float
  currency    String
  quantity    Int
  description String?
  available   Boolean
  soldCount   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  eventId     String
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Collaborator {
  id          String  @id @default(cuid())
  name        String
  type        String
  avatar      String?
  role        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  eventId     String
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// Mail subscriptions
model MailSubscription {
  id             String              @id @default(cuid())
  email          String              @unique
  name           String?
  status         SubscriptionStatus  @default(PENDING)
  token          String?
  subscribedAt   DateTime            @default(now())
  verifiedAt     DateTime?
  unsubscribedAt DateTime?
  preferences    Json?
  source         SubscriptionSource?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

// Site Builder pages
model Page {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  metadata    Json
  template    Json?
  sectionData Json?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sections PageSection[]
}

model PageSection {
  id        String      @id @default(cuid())
  builderId String // Section id from SiteBuilder config
  type      SectionType
  order     Int
  data      Json

  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
}
